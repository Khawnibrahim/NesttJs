{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "./",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true
  }
}
